# Maintainer: arcbaseproject <arcbaseproject@users.noreply.github.com>
pkgname=cedit
pkgver=1.1.0
pkgrel=0
pkgdesc="Small terminal text editor with nano keys and language-server support"
url="https://github.com/arcbaseproject/cedit"
arch="all"
license="GPL-3.0-or-later"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/arcbaseproject/cedit/archive/refs/tags/v$pkgver.tar.gz"

build() {
	make
}

check() {
	make test
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" install
}

