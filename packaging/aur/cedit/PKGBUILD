# Maintainer: arcbaseproject
pkgname=cedit
pkgver=1.0.1
pkgrel=1
pkgdesc='Small terminal text editor with nano keys, Emacs keys and language-server support'
arch=('x86_64' 'aarch64')
url='https://github.com/arcbaseproject/cedit'
license=('GPL-3.0-or-later')
depends=('glibc')
optdepends=('clang: C/C++ language server (clangd)'
            'rust-analyzer: Rust language server'
            'gopls: Go language server'
            'python-lsp-server: Python language server')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('210831125888213e38b2e6e3c816f833258068cc3d13a5120cf6c86d40427553')

build() {
  cd "$pkgname-$pkgver"
  make
}

check() {
  cd "$pkgname-$pkgver"
  make test
}

package() {
  cd "$pkgname-$pkgver"
  make PREFIX=/usr DESTDIR="$pkgdir" install
}
